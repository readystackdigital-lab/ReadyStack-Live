# CSP note: no default-src / connect-src on purpose. The chat widget does a
# browser-side import() of https://esm.sh/retell-client-js-sdk and the voice
# call then talks to Retell/LiveKit hosts we cannot enumerate here, so those
# two directives need a Content-Security-Policy-Report-Only pass against real
# traffic before they can be enforced. Everything below is verified against
# what the site actually loads.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin
  Permissions-Policy: camera=(), geolocation=(), payment=(), usb=(), microphone=(self), interest-cohort=(), browsing-topics=()
  Content-Security-Policy: script-src 'self' 'unsafe-inline' https://agent.readystackdigital.com https://esm.sh; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; media-src 'self' blob:; frame-src https://cal.com https://app.cal.com https://agent.readystackdigital.com; form-action 'self'; frame-ancestors 'self'; object-src 'none'; base-uri 'self'; upgrade-insecure-requests

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/assets/*
  Cache-Control: public, max-age=86400

/images/*
  Cache-Control: public, max-age=86400
