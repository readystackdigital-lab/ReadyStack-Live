  { label: "AI Receptionist", icon: `<svg class="marquee-spark" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#10B981" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 13.5v-1.7a8 8 0 0 1 16 0v1.7"/><rect x="2.4" y="13" width="4.4" height="6" rx="2.2"/><rect x="17.2" y="13" width="4.4" height="6" rx="2.2"/><path d="M19.8 19v.6a2.8 2.8 0 0 1-2.8 2.8h-2.4"/></svg>` },
  { label: "AI Agents", icon: `<svg class="marquee-spark" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#A78BFA" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="7.6" width="16" height="12" rx="3.6"/><path d="M9.6 12.6v1.6M14.4 12.6v1.6"/><path d="M12 3.2v4.4M9.9 4.4 12 5.6M14.1 4.4 12 5.6"/></svg>` },
  { label: "Never Miss a Call", icon: `<svg class="marquee-spark" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#F87171" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6.4 3.4h3.1l1.5 4-2 1.4a12.2 12.2 0 0 0 6.2 6.2l1.4-2 4 1.5v3.1a2 2 0 0 1-2.2 2A17.2 17.2 0 0 1 4.4 5.6a2 2 0 0 1 2-2.2z"/></svg>` },
  { label: "Business Email", icon: `<svg class="marquee-spark" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#60A5FA" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2.5" y="5" width="19" height="14" rx="2.6"/><path d="M3.2 7.2 12 13l8.8-5.8"/></svg>` },
  { label: "Monthly Care", icon: `<svg class="marquee-spark" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="#A3E635" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2.5 4 6v6c0 4.4 3.4 8 8 9.5 4.6-1.5 8-5.1 8-9.5V6z"/><path d="M8.7 12.2 11 14.5l4.3-4.4"/></svg>` },
];
---

<section id="hero" aria-label="Hero: get your business online and never miss a call">

  <!-- ── Background: charcoal base + amber aurora + dot grid + grain ── -->
  <div class="hero-bg" aria-hidden="true">
    <div class="bg-aurora"></div>
    <div class="bg-dots"></div>
    <div class="bg-grain"></div>
  </div>

  <div class="hero-body">
  <div class="hero-wrap">
    <div class="hero-inner">

      <!-- ══════════════════════════════════════════════════════
           CONTENT — real, crawlable, JS-independent HTML
           (headline/sub/CTAs copy preserved verbatim)
      ══════════════════════════════════════════════════════ -->
      <div class="hero-text">
        <p class="hero-ai">
          <span class="hero-ai-label">Get visible in AI</span>
          <span class="hero-ai-rotator">
            {aiTargets.map((t, i) => (
              <span class="hero-ai-slot" style={`--i:${i};--tint:${t.tint}`}>
                <Fragment set:html={t.icon} />
                {t.name}
              </span>
            ))}
          </span>
        </p>

        <h1 class="hero-headline">
          Get your business online,
          <span class="headline-amber">win more customers,</span>
          <span class="headline-outline">and never miss a call.</span>
        </h1>

        <p class="hero-sub">
          We build and rebuild fast websites for Australian small businesses, get you found on Google and in AI, and add custom AI agents that answer every call around the clock and automate the repetitive jobs eating your week.
        </p>

        <div class="hero-ctas">
          <a href="/estimate" class="btn btn-amber btn-lg magnetic">
            <span>Get My Free Quote</span>
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
              <path d="M3 9h12M9 3l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
          <!-- Opens the live agent so visitors meet the product instead of
               reading about it. Stays a real link to /services#ai so it works
               without JS and when widget.js (async) has not landed yet. The
               label is "Ask" rather than "Talk" because inside the panel
               "Talk to Emma" already means starting a voice call. -->
          <a href="/services#ai" class="btn btn-hero-ghost btn-lg" data-emma-open>
            <svg width="18" height="18" viewBox="0 0 20 18" fill="none" aria-hidden="true">
              <path d="M4.6 1.4h10.8a3.2 3.2 0 0 1 3.2 3.2v5.2a3.2 3.2 0 0 1-3.2 3.2H8.4l-6 3.6 2.6-3.6a3.2 3.2 0 0 1-3.2-3.2V4.6a3.2 3.2 0 0 1 3.2-3.2Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
              <circle cx="7" cy="7.2" r="1" fill="currentColor"/>
              <circle cx="10" cy="7.2" r="1" fill="currentColor"/>
              <circle cx="13" cy="7.2" r="1" fill="currentColor"/>
            </svg>
            <span>Ask Emma</span>
          </a>
        </div>

        <p class="hero-trust">Websites from $799. Monthly care from $99. AI reception from $149/month.</p>

        <div class="hero-support">
          <div class="hero-book-link">
            <svg width="13" height="13" viewBox="0 0 18 18" fill="none" aria-hidden="true">
              <path d="M3.75 3.75h2.625L7.5 6.563 6.094 7.406a8.25 8.25 0 0 0 4.5 4.5L11.438 10.5l2.813 1.125-.75 2.625a1.125 1.125 0 0 1-1.125 1.125A11.25 11.25 0 0 1 2.625 4.875 1.125 1.125 0 0 1 3.75 3.75z" stroke="currentColor" stroke-width="1.3" fill="none"/>
            </svg>
            Prefer to talk first?&nbsp;<a href="/contact#book" class="hero-book-link__anchor">Book a free 30-min strategy call</a>, no commitment
          </div>

          <div class="hero-proof">
            {proofItems.map((label) => (
              <span class="proof-item">
                <svg width="14" height="14" viewBox="0 0 15 15" fill="none" aria-hidden="true"><path d="M2 7.5l4 4 7-7" stroke="#F59E0B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                {label}
              </span>
            ))}
          </div>
        </div>
      </div><!-- /hero-text -->

    </div><!-- /hero-inner -->
  </div><!-- /hero-wrap -->

  <!-- ══════════════════════════════════════════════════════
       VISUAL — full-height video panel, flush to the hero's
       right edge, one huge sweeping curve on the top-left
       (reference-matched framing) + floating service card
       + hand-drawn connector arrow
  ══════════════════════════════════════════════════════ -->
  <div class="hero-visual">
        <!-- .visual-scroll is the GSAP scroll-parallax target: kept
             separate from .hero-visual so scroll transforms never sit
             on the panel that global CSS might target by class name
             (old-hero globals once did exactly that; see layout.css
             "Hero" note). -->
        <div class="visual-scroll">
          <div class="visual-glow" aria-hidden="true"></div>

          <div class="video-frame">
            <video
              class="video-el"
              src="/assets/video/hero-video.mp4?v=2"
              autoplay
              loop
              muted
              playsinline
              preload="none"
              aria-hidden="true"
            ></video>
            <div class="video-sheen" aria-hidden="true"></div>
          </div>

          <svg class="connector-arrow" viewBox="0 0 180 130" fill="none" aria-hidden="true">
            <path class="connector-path" d="M8 14C36 10 58 26 50 46C44 62 20 60 22 78C24 96 56 92 70 104C82 114 96 116 108 112"
              stroke="#F59E0B" stroke-width="2" stroke-linecap="round" stroke-dasharray="4 7"/>
            <path d="M100 106l10 8-2-13" stroke="#F59E0B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
          </svg>

          <a href="/packages#ai-agent" class="floating-card">
            <span class="floating-card-icon" aria-hidden="true">
              <svg width="19" height="19" viewBox="0 0 18 18" fill="none">
                <rect x="2" y="3.5" width="14" height="11" rx="1.6" stroke="currentColor" stroke-width="1.4"/>
                <path d="M2 6.5h14" stroke="currentColor" stroke-width="1.4" stroke-linecap="round"/>
                <circle cx="4.2" cy="5" r=".55" fill="currentColor"/>
                <circle cx="6" cy="5" r=".55" fill="currentColor"/>
              </svg>
            </span>
            <span class="floating-card-copy">
              <strong>24/7 AI<br>Receptionist</strong>
            </span>
          </a>
        </div><!-- /visual-scroll -->
      </div><!-- /hero-visual -->
  </div><!-- /hero-body -->

  <!-- ══════════════════════════════════════════════════════
       Bottom marquee strip — reuses the site's existing
       marquee-outer/track/set convention (public/css/layout.css)
  ══════════════════════════════════════════════════════ -->
  <div class="hero-marquee" aria-hidden="true">
    <div class="marquee-outer">
      <div class="marquee-track">
        {["a", "b"].map((copy) => (
          <div class="marquee-set">
            {marqueeItems.map((item) => (
              <span class="marquee-item">
                <Fragment set:html={item.icon.replaceAll("{S}", copy)} />
                {item.label}
              </span>
            ))}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style is:global>
  html.lenis, html.lenis body { height: auto; }
  .lenis.lenis-smooth { scroll-behavior: auto !important; }
  .lenis.lenis-smooth [data-lenis-prevent] { overscroll-behavior: contain; }
  .lenis.lenis-stopped { overflow: clip; }
  .lenis.lenis-smooth iframe { pointer-events: none; }
</style>

<style>
  /* ═══════════════════════════════════════════════════════════
     SHELL + palette
  ═══════════════════════════════════════════════════════════ */
  #hero {
    --accent: var(--amber, #F59E0B);
    --accent-2: var(--amber-300, #FCD34D);
    --cream: #FAF6EF;
    /* single source of truth for the text-column width + the gap
       before the video panel, so the panel's left edge is always
       derived from where the text actually ends (see .hero-visual
       `left` below) instead of two independent guesses that can
       drift apart into an awkward gap on wide viewports. */
    --hero-text-w: 500px;
    --hero-gap: 56px;
    position: relative;
    display: block;
    padding: 0;
    overflow: hidden;
    isolation: isolate;
    background:
      radial-gradient(95% 85% at 82% 6%, rgba(245,158,11,.13), transparent 52%),
      radial-gradient(70% 65% at 4% 96%, rgba(245,158,11,.05), transparent 60%),
      linear-gradient(163deg, #16181e 0%, #0d0f13 52%, #0a0c0f 100%);
  }

  /* ── Background layers ─────────────────────────────────── */
  .hero-bg { position: absolute; inset: 0; z-index: 0; pointer-events: none; }
  .bg-aurora {
    position: absolute; inset: -12%;
    background:
      radial-gradient(34% 44% at 78% 26%, rgba(245,158,11,.16), transparent 70%),
      radial-gradient(26% 34% at 18% 80%, rgba(252,211,77,.06), transparent 70%);
    filter: blur(22px);
    animation: aurora-breathe 12s ease-in-out infinite;
  }
  @keyframes aurora-breathe {
    0%, 100% { opacity: 1; transform: translate3d(0,0,0); }
    50%      { opacity: .8; transform: translate3d(-1.5%, 1.5%, 0); }
  }
  .bg-dots {
    position: absolute; inset: 0;
    background-image: radial-gradient(rgba(255,255,255,.06) 1px, transparent 1.4px);
    background-size: 26px 26px;
    mask-image: radial-gradient(75% 75% at 68% 38%, #000 0%, transparent 78%);
    -webkit-mask-image: radial-gradient(75% 75% at 68% 38%, #000 0%, transparent 78%);
  }
  .bg-grain {
    position: absolute; inset: 0; opacity: .13; mix-blend-mode: soft-light;
    background: url('/images/hero/grain.webp') repeat; background-size: 320px 320px;
  }

  /* ═══════════════════════════════════════════════════════════
     LAYOUT — editorial left, video panel right
  ═══════════════════════════════════════════════════════════ */
  /* .hero-body hosts the absolute right-bleed video panel; text
     flows in .hero-wrap on the left ~46% */
  .hero-body {
    position: relative; z-index: 1;
    min-height: clamp(600px, 88svh, 860px);
    padding-top: calc(var(--nav-h, 72px) + clamp(1rem, 2.5vh, 2rem));
    display: flex; align-items: center;
  }
  .hero-wrap {
    position: relative; z-index: 2;
    width: min(1280px, calc(100% - 56px));
    margin-inline: auto;
    padding: clamp(1.5rem, 3vh, 2.5rem) 0;
  }
  #hero .hero-inner { display: block; width: 100%; padding: 0; max-width: none; }
  .hero-text { position: relative; max-width: var(--hero-text-w); text-align: left; }

  #hero .hero-headline {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.3rem, 3.3vw, 3.5rem);
    line-height: 1.08;
    letter-spacing: -0.045em;
    color: #fff;
  }  #hero .headline-amber {
    color: var(--accent);
    text-shadow: 0 0 46px rgba(245,158,11,.4), 0 0 110px rgba(245,158,11,.15);
  }
  #hero .headline-outline {
    color: rgba(255, 255, 255, .78);
    -webkit-text-stroke: 0;
    text-shadow: 0 1px 0 rgba(255, 255, 255, .10), 0 8px 26px rgba(0, 0, 0, .55);
  }

  #hero .hero-sub {
    max-width: 540px;
    margin-top: clamp(1rem, 1.8vw, 1.4rem);
    font-size: clamp(1rem, 1.05vw, 1.08rem);
    line-height: 1.68;
    color: rgba(255,255,255,.72);
  }

  /* ── AI line: one brand pill on screen at a time, flipping up ──── */
  .hero-ai {
    display: flex; align-items: center; flex-wrap: wrap; gap: .85rem;
    margin-bottom: clamp(1.1rem, 2vw, 1.6rem);
  }
  .hero-ai-label {
    font-family: var(--font-display); font-weight: 600;
    font-size: clamp(.95rem, 1vw, 1.04rem); letter-spacing: -.01em;
    color: rgba(255,255,255,.92);
  }
  /* inline-grid stacks every pill in one cell, so the box is as wide as the
     widest brand and nothing reflows as they swap */
  .hero-ai-rotator { display: inline-grid; perspective: 700px; }
  .hero-ai-slot {
    grid-area: 1 / 1; justify-self: start;
    display: inline-flex; align-items: center; gap: .45rem;
    padding: .34rem .78rem .34rem .55rem;
    border-radius: 999px;
    border: 1px solid rgba(var(--tint), .42);
    background: rgba(var(--tint), .13);
    font-family: var(--font-display); font-weight: 600; font-size: .92rem;
    color: #fff; white-space: nowrap;
    transform-origin: 50% 130%;
    opacity: 0;
    animation: ai-flip 13s cubic-bezier(.2,.8,.2,1) infinite;
    animation-delay: calc(var(--i) * 2.6s);
  }
  /* :global() because the marks are injected with set:html and never get
     Astro's scope attribute (same reason as .marquee-spark below) */
  .hero-ai-slot :global(svg) { width: 17px; height: 17px; flex: 0 0 auto; }
  @keyframes ai-flip {
    0%     { opacity: 0; transform: translateY(.45em) rotateX(-80deg); filter: blur(5px); }
    2.8%   { opacity: 1; transform: none; filter: blur(0); }
    17.2%  { opacity: 1; transform: none; filter: blur(0); }
    20%    { opacity: 0; transform: translateY(-.45em) rotateX(80deg); filter: blur(5px); }
    100%   { opacity: 0; transform: translateY(-.45em) rotateX(80deg); filter: blur(5px); }
  }

  .hero-ctas { display: flex; align-items: center; flex-wrap: wrap; gap: .75rem; margin-top: clamp(1.4rem, 2.2vw, 1.9rem); }
  .hero-ctas .btn { min-height: 48px; }

  .hero-trust { margin-top: 1.1rem; font-size: .82rem; color: rgba(255,255,255,.6); }

  .hero-support { margin-top: clamp(1.3rem, 2vw, 1.7rem); padding-top: 1.1rem; border-top: 1px solid rgba(255,255,255,.08); }
  .hero-book-link { display: flex; align-items: center; gap: .35rem; font-size: .78rem; color: rgba(255,255,255,.6); flex-wrap: wrap; line-height: 1.5; }
  .hero-book-link svg { flex-shrink: 0; color: rgba(255,255,255,.6); }
  .hero-book-link__anchor { color: var(--accent); text-decoration: none; font-weight: 600; }
  .hero-book-link__anchor:hover { text-decoration: underline; text-underline-offset: 3px; }
  .hero-proof { display: flex; align-items: center; flex-wrap: wrap; gap: .42rem; margin-top: .85rem; }
  .proof-item {
    display: inline-flex; align-items: center; gap: .38rem;
    padding: .3rem .56rem; border: 1px solid rgba(255,255,255,.1); border-radius: 999px;
    background: rgba(255,255,255,.04); color: rgba(255,255,255,.66);
    font-size: .74rem; line-height: 1.2;
    transition: border-color .22s, background .22s, color .22s;
  }
  .proof-item svg { flex: 0 0 auto; }
  .proof-item:hover { border-color: rgba(245,158,11,.32); background: rgba(245,158,11,.07); color: rgba(255,255,255,.88); }

  .btn-hero-ghost {
    display: inline-flex; align-items: center; justify-content: center; gap: .5rem;
    font-family: var(--font-display); font-weight: var(--weight-semibold); font-size: var(--text-md);
    padding: .85rem 1.85rem; min-height: 48px;
    background: rgba(255,255,255,.04); color: rgba(255,255,255,.8);
    border: 1.5px solid rgba(255,255,255,.2); border-radius: var(--radius-full);
    cursor: pointer; text-decoration: none; white-space: nowrap;
    transition: background .18s, color .18s, border-color .18s, transform .18s;
  }
  .btn-hero-ghost:hover { background: rgba(255,255,255,.09); color: #EEEFF2; border-color: rgba(255,255,255,.36); transform: translateY(-1px); }
  .btn-hero-ghost:active { transform: scale(.97); }

  .hero-ctas .btn-amber { position: relative; overflow: hidden; }
  .hero-ctas .btn-amber::after {
    content:''; position: absolute; inset: 0; border-radius: inherit; pointer-events: none;
    background: linear-gradient(108deg, transparent 30%, rgba(255,255,255,.26) 50%, transparent 70%);
    background-size: 200% 100%; animation: btn-gleam 3.4s ease-in-out 2.4s infinite;
  }
  @keyframes btn-gleam { 0%{ background-position:180% center; opacity:0; } 18%{opacity:1;} 82%{opacity:1;} 100%{ background-position:-80% center; opacity:0; } }

  /* ═══════════════════════════════════════════════════════════
     VISUAL — video panel, floating card, connector arrow
  ═══════════════════════════════════════════════════════════ */
  /* Reference framing: the panel is absolute, FULL HEIGHT of the
     hero body, flush against the hero's right edge (no right
     margin), ending at the marquee strip below. The explicit
     display/width/alignment resets below stay as insurance against
     global rules landing on this class name again (old-hero globals
     once flex-shrank .video-frame to ~2px). */
  .hero-visual {
    display: block;
    position: absolute;
    /* +4.25rem on top and bottom = ~136px combined, a ~15% height
       cut from the previous full-bleed-vertical size, split evenly
       so the panel stays centered in the same vertical envelope. */
    top: calc(var(--nav-h, 72px) + clamp(2rem, 6vh, 4rem) + 4.25rem);
    /* left edge = hero-wrap's own left inset (mirrors its
       `min(1280px, 100% - 56px)` width via max(28px, ...)) + the
       text column's width + one deliberate gap. right:0 with no
       explicit width lets the browser compute width as exactly
       "fill to the hero's right edge" — no independent guess to
       drift out of sync with the text column. */
    left: calc(max(28px, (100% - 1280px) / 2) + var(--hero-text-w) + var(--hero-gap));
    right: 0; bottom: calc(clamp(2rem, 6vh, 4rem) + 4.25rem);
    /* explicit `auto` so the browser computes width from left/right —
       and so any future global `width` on this class name can't win */
    width: auto;
    justify-content: normal; align-items: normal;
  }
  .visual-scroll { position: relative; width: 100%; height: 100%; }

  .visual-glow {
    position: absolute; inset: -6% -2% -6% -14%;
    background: radial-gradient(55% 50% at 30% 40%, rgba(245,158,11,.18), transparent 70%);
    filter: blur(30px);
    pointer-events: none;
  }

  /* the signature mask: one giant sweeping curve on the top-left,
     a softer curve on the bottom-left, square on the right where
     the panel bleeds off the hero's edge (reference-matched) */
  .video-frame {
    position: relative;
    width: 100%; height: 100%;
    border-radius: clamp(150px, 17vw, 250px) 0 0 clamp(70px, 8vw, 120px);
    overflow: hidden;
    border: 1px solid rgba(255,255,255,.12);
    border-right: none;
    box-shadow: -30px 40px 90px -30px rgba(0,0,0,.6), inset 0 1px 0 rgba(255,255,255,.08);
    will-change: transform;
  }
  .video-el {
    position: absolute; inset: 0;
    width: 100%; height: 100%;
    /* the playing video is promoted to its own compositor layer, which
       can skip the parent's border-radius clip while the frame animates
       (square corners flash outside the curve) — so the video rounds
       its own layer too instead of relying on ancestor clipping alone */
    border-radius: inherit;
    object-fit: cover;
    object-position: 50% 42%;
    /* no baseline zoom — widest natural crop (both monitors + desk),
       matching the reference's spacious framing. GSAP only zooms in
       gently on scroll (see script below). */
    filter: saturate(.92) brightness(.86) contrast(1.04);
  }
  .video-sheen {
    position: absolute; inset: 0;
    border-radius: inherit;
    background: linear-gradient(200deg, rgba(245,158,11,.14), transparent 40%, rgba(10,12,16,.35) 100%);
    mix-blend-mode: normal;
    pointer-events: none;
  }

  /* hand-drawn connector arrow, text-column → floating card */
  /* squiggle sits in the dark gap left of the panel's lower curve,
     pointing at the floating card (as in the reference) */
  .connector-arrow {
    position: absolute; left: -17%; bottom: 12%;
    width: 22%; height: auto;
    overflow: visible;
    pointer-events: none;
  }
  .connector-path { stroke-dashoffset: 0; }

  /* floating cream service card — the one deliberate light accent */
  /* card rides ON the panel near its lower-left curve (reference) */
  .floating-card {
    position: absolute; left: 4%; bottom: 9%;
    display: flex; align-items: center; gap: .8rem;
    max-width: 232px;
    padding: 1rem 1.15rem;
    border-radius: 20px;
    background: var(--cream);
    box-shadow: 0 26px 50px -16px rgba(0,0,0,.5), 0 0 0 1px rgba(0,0,0,.03), inset 0 1px 0 rgba(255,255,255,.9), inset 0 -2px 6px rgba(28,28,30,.06);
    text-decoration: none;
    transition: transform .32s cubic-bezier(.22,1,.36,1), box-shadow .32s ease;
  }
  .floating-card:hover { transform: translateY(-4px); box-shadow: 0 34px 60px -16px rgba(0,0,0,.55), 0 0 0 1px rgba(0,0,0,.03); }
  .floating-card-icon {
    flex: 0 0 auto; width: 40px; height: 40px; border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    background: linear-gradient(135deg, var(--accent), #d97a06);
    color: #1a1206;
  }
  .floating-card-copy { display: flex; flex-direction: column; gap: .18rem; }
  .floating-card-copy strong {
    font-family: var(--font-display); font-size: .92rem; line-height: 1.15;
    letter-spacing: -.01em; color: #1c1710;
  }
  .floating-card-sub { font-size: .72rem; color: #6b6255; font-weight: 500; }

  /* ═══════════════════════════════════════════════════════════
     BOTTOM MARQUEE STRIP — full-bleed, reuses site marquee convention
  ═══════════════════════════════════════════════════════════ */
  .hero-marquee {
    position: relative; z-index: 1;
    border-top: 1px solid rgba(255,255,255,.08);
    background: rgba(0,0,0,.22);
    padding: 1.25rem 0;
  }
  .hero-marquee .marquee-set { gap: var(--space-10, 3rem); padding-right: var(--space-10, 3rem); }
  .marquee-item {
    display: inline-flex; align-items: center; gap: .7rem;
    font-family: var(--font-mono); font-size: .88rem; letter-spacing: .04em;
    color: rgba(255,255,255,.78); white-space: nowrap;
  }
  /* One rule sizes all 12 marks (CSS beats the width/height attributes).
     :global() is required: the icons are injected with set:html, so Astro
     never stamps its scope attribute on them and a scoped selector misses. */
  .hero-marquee :global(.marquee-spark) {
    flex: 0 0 auto; width: 22px; height: 22px; opacity: 1;
  }

  /* ═══════════════════════════════════════════════════════════
     INTRO — pure-CSS auto-play (JS-independent; ends visible)
  ═══════════════════════════════════════════════════════════ */
  @media (prefers-reduced-motion: no-preference) {
    #hero .hero-headline { animation: hl-wipe .9s cubic-bezier(.16,1,.3,1) .05s both; }
    .hero-ai       { animation: rise .7s cubic-bezier(.16,1,.3,1) .1s both; }
    .hero-sub      { animation: rise .8s cubic-bezier(.16,1,.3,1) .42s both; }
    .hero-ctas     { animation: rise .7s cubic-bezier(.16,1,.3,1) .54s both; }
    .hero-trust    { animation: rise .7s cubic-bezier(.16,1,.3,1) .62s both; }
    .hero-support  { animation: rise .7s cubic-bezier(.16,1,.3,1) .72s both; }
    .video-frame   { animation: frame-in 1s cubic-bezier(.16,1,.3,1) .2s both; }
    .floating-card { animation: card-in .8s cubic-bezier(.16,1,.3,1) 1.05s both, card-float 6s ease-in-out 1.9s infinite; }
    .connector-path { animation: draw-arrow 1.1s cubic-bezier(.5,0,.2,1) 1.3s both; }
  }
  @keyframes hl-wipe { from { clip-path: inset(0 0 102% 0); } to { clip-path: inset(0 0 -12% 0); } }
  @keyframes rise   { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }
  @keyframes frame-in { from { opacity: 0; transform: scale(.94) translateY(16px); } to { opacity: 1; transform: scale(1) translateY(0); } }
  @keyframes card-in { from { opacity: 0; transform: translateY(18px) scale(.92); } to { opacity: 1; transform: translateY(0) scale(1); } }
  @keyframes card-float { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }
  @keyframes draw-arrow { from { opacity: 0; stroke-dashoffset: 140; } to { opacity: 1; stroke-dashoffset: 0; } }

  /* ═══════════════════════════════════════════════════════════
     RESPONSIVE
  ═══════════════════════════════════════════════════════════ */
  /* ── Short viewports: tighten the vertical rhythm so the marquee strip
        still lands above the fold on a laptop. Desktop layout only; the
        stacked mobile layout below 900px scrolls anyway. ───────────── */
  @media (min-width: 901px) and (max-height: 940px) {
    .hero-body { min-height: 0; padding-top: calc(var(--nav-h, 72px) + .45rem); }
    .hero-wrap { padding: .6rem 0; }
    .hero-ai { margin-bottom: .7rem; }
    #hero .hero-sub { margin-top: .75rem; }
    .hero-ctas { margin-top: .9rem; }
    .hero-trust { margin-top: .65rem; }
    .hero-support { margin-top: .75rem; padding-top: .65rem; }
    .hero-proof { margin-top: .5rem; }
    .proof-item { padding: .26rem .52rem; font-size: .72rem; }
  }

  /* Very short viewports: step the headline down a notch as well. */
  @media (min-width: 901px) and (max-height: 780px) {
    #hero .hero-headline { font-size: clamp(2rem, 2.75vw, 2.9rem); }
    #hero .hero-sub { font-size: 1rem; line-height: 1.6; }
  }

  @media (max-width: 1100px) {
    #hero { --hero-text-w: 380px; --hero-gap: 36px; }
    .floating-card { max-width: 200px; padding: .85rem 1rem; }
  }
  @media (max-width: 900px) {
    .hero-body { display: block; min-height: 0; }
    .hero-text { max-width: 620px; min-width: 0; }
    /* panel returns to flow: full-width-ish, still bleeding to the
       right viewport edge, keeping the big top-left sweep */
    .hero-visual {
      position: relative; top: auto; right: auto; bottom: auto; left: auto;
      width: calc(100% - 60px);
      height: clamp(204px, 32vw, 289px);
      margin: 2.2rem 0 2.4rem auto;
    }
    .video-frame { border-radius: clamp(90px, 22vw, 140px) 0 0 clamp(40px, 10vw, 64px); }
    .connector-arrow { display: none; }
    .floating-card { left: 5%; bottom: 8%; }
    #hero .hero-headline br { display: none; }
  }
  @media (max-width: 560px) {
    #hero .hero-headline { font-size: clamp(2.1rem, 8.6vw, 2.8rem); letter-spacing: -.04em; }
    .hero-ctas .btn, .btn-hero-ghost { width: 100%; max-width: 320px; }
    .floating-card { position: absolute; max-width: 220px; padding: .8rem .95rem; }
    .hero-marquee { padding: 1rem 0; }
    .marquee-item { font-size: .78rem; gap: .55rem; }
    .hero-marquee :global(.marquee-spark) { width: 18px; height: 18px; }
  }

  /* ── Reduced motion: static, fully visible ──────────────── */
  @media (prefers-reduced-motion: reduce) {
    .bg-aurora, .hero-ctas .btn-amber::after,
    .floating-card, .video-frame, .connector-path { animation: none !important; }
    #hero .hero-headline { clip-path: none !important; }
    #hero .hero-text > *, .video-frame, .floating-card, .connector-path { opacity: 1 !important; }
    .marquee-track { animation-play-state: paused; }
    .hero-ai-slot { animation: none; opacity: 0; filter: none; transform: none; }
    .hero-ai-slot:first-child { opacity: 1; }
  }
</style>

<!-- ═══════════════════════════════════════════════════════════
     Motion island — bundled (vanilla TS + GSAP + Lenis).
     Desktop fine-pointer + not-reduced only. Content never
     depends on this script (intro + marquee are pure CSS).
═══════════════════════════════════════════════════════════ -->
<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import Lenis from 'lenis';
  import { particleHeadline } from '../scripts/particle-headline';

  const hero = document.getElementById('hero');

  // 21st.dev particle-text-canvas effect on the H1 (self-gating —
  // desktop fine-pointer only; see src/scripts/particle-headline.ts)
  particleHeadline(hero?.querySelector<HTMLElement>('.hero-headline') ?? null);

  if (hero) {
    const fine   = window.matchMedia('(pointer: fine) and (min-width: 901px)');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    // gate on the media query's change event too, not just a one-shot
    // sample at eval time — a window that loads narrow (or a pointer
    // that registers late) would otherwise never get motion at all
    let started = false;
    const tryStart = () => {
      if (started || !fine.matches || reduce.matches) return;
      started = true;
      const start = () => initMotion(hero);
      'requestIdleCallback' in window
        ? (window as any).requestIdleCallback(start, { timeout: 600 })
        : setTimeout(start, 200);
    };
    tryStart();
    fine.addEventListener('change', tryStart);
  }

  function initMotion(hero: HTMLElement) {
    gsap.registerPlugin(ScrollTrigger);

    const visual = hero.querySelector<HTMLElement>('.visual-scroll');
    const frame  = hero.querySelector<HTMLElement>('.video-frame');
    const video  = hero.querySelector<HTMLElement>('.video-el');
    const text   = hero.querySelector<HTMLElement>('.hero-text');
    if (!visual || !frame) return;

    /* ── Lenis smooth-scroll (global, lightweight, removable) ── */
    const lenis = new Lenis({ lerp: 0.1, smoothWheel: true });
    lenis.on('scroll', ScrollTrigger.update);
    gsap.ticker.add((t) => lenis.raf(t * 1000));
    gsap.ticker.lagSmoothing(0);

    /* ── Scroll choreography: gentle parallax recede + Ken Burns ── */
    gsap.timeline({ scrollTrigger: { trigger: hero, start: 'top top', end: 'bottom top', scrub: 1 } })
      .fromTo(visual, { y: 0 }, { y: -60, ease: 'none' }, 0)
      .to(text,   { y: -30, autoAlpha: .55, ease: 'power1.in' }, 0.35)
      .to(visual, { autoAlpha: .5, ease: 'power1.in' }, 0.45);

    if (video) {
      /* starts at the CSS baseline (no zoom, widest crop) and only
         eases in gently — the resting frame is what matters for
         matching the reference's wider framing */
      gsap.to(video, { scale: 1.08, ease: 'none', scrollTrigger: { trigger: hero, start: 'top top', end: 'bottom top', scrub: 1 } });
    }

    /* ── Cursor parallax tilt on the video panel ── */
    let tx = 0, ty = 0, rx = 0, ry = 0, raf = 0;
    const onMove = (e: PointerEvent) => {
      const rect = visual.getBoundingClientRect();
      tx = ((e.clientX - rect.left) / rect.width  - 0.5) * 2;
      ty = ((e.clientY - rect.top)  / rect.height - 0.5) * 2;
    };
    const tick = () => {
      rx += (tx * 4 - rx) * 0.06;
      ry += (-ty * 3 - ry) * 0.06;
      frame.style.transform = `rotateY(${rx.toFixed(2)}deg) rotateX(${ry.toFixed(2)}deg)`;
      raf = requestAnimationFrame(tick);
    };
    hero.addEventListener('pointermove', onMove, { passive: true });
    frame.style.transformStyle = 'preserve-3d';
    (hero.querySelector('.hero-body') as HTMLElement).style.perspective = '1200px';
    raf = requestAnimationFrame(tick);

    window.addEventListener('pagehide', () => {
      cancelAnimationFrame(raf);
      hero.removeEventListener('pointermove', onMove);
      ScrollTrigger.getAll().forEach((s) => s.kill());
      lenis.destroy();
    }, { once: true });
  }
</script>

<!-- Hero "Ask Emma": hand the click to the agent widget when it is there, and
     otherwise do nothing so the anchor's href (/services#ai) carries on. That
     keeps the button useful with JS off, with the widget blocked, and in the
     window before the async widget.js has run. Delegated from document so it
     does not care when the button or the widget shows up. -->
<script is:inline>
  document.addEventListener("click", function (e) {
    var trigger = e.target && e.target.closest && e.target.closest("[data-emma-open]");
    if (!trigger) return;
    var api = window.RSStack;
    if (!api || typeof api.open !== "function") return;
    e.preventDefault();
    api.open({ demo: true });
  });
</script>
