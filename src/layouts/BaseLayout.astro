---
import CookieConsent from "../components/CookieConsent.astro";
import CartDrawer from "../components/CartDrawer.astro";
import MobileTabBar from "../components/MobileTabBar.astro";

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  breadcrumb?: { name: string; path: string }[];
}

const {
  // Homepage only (every other page passes its own title). Brand-first because
  // Google reads the homepage <title> as a candidate for the site name shown
  // above the search result.
  title = "ReadyStack Digital | Small Business Websites & AI Reception",
  description = "Fast websites for Australian small businesses, rebuilds for slow and outdated ones, and 24/7 AI receptionists so you never miss a call. From $799, no lock-in contracts.",
  ogImage: ogImageProp,
  ogType = "website",
  breadcrumb,
} = Astro.props;

const siteUrl = "https://readystackdigital.com";
// encodeURI: CMS-uploaded filenames can contain spaces, which break og:image.
const ogImage = encodeURI(
  ogImageProp
    ? (ogImageProp.startsWith("http") ? ogImageProp : `${siteUrl}${ogImageProp}`)
    : `${siteUrl}/assets/images/hero-dashboard.jpg`,
);

// Per-page canonical + OG URL derived from the current route
const pathname = Astro.url.pathname.replace(/\/index\.html$/, "/");
const canonicalURL = new URL(pathname, siteUrl).href;
const isHome = pathname === "/" || pathname === "";

// Breadcrumb: explicit prop, else auto from path (Home + current segment)
const crumbs =
  breadcrumb ??
  (isHome
    ? [{ name: "Home", path: "/" }]
    : [
        { name: "Home", path: "/" },
        {
          name: pathname
            .replace(/\//g, " ")
            .trim()
            .replace(/-/g, " ")
            .replace(/\b\w/g, (c) => c.toUpperCase()),
          path: pathname,
        },
      ]);
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: crumbs.map((c, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: c.name,
    item: new URL(c.path, siteUrl).href,
  })),
};

---

<!DOCTYPE html>
<html lang="en-AU" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <!-- Theme bootstrap (no flash): default dark, honours saved choice -->
  <script is:inline>
    (function () {
      try {
        var t = localStorage.getItem("rsd-theme");
        if (t === "light" || t === "dark") {
          document.documentElement.setAttribute("data-theme", t);
        }
      } catch (e) {}
      try {
        if (sessionStorage.getItem("rsd-intro-seen")) {
          document.documentElement.classList.add("intro-seen");
        }
      } catch (e) {}
    })();
  </script>
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <!-- Google Search Console verification -->
  <meta name="google-site-verification" content="TECjncSlTZtlXfk6oxgKHWDX32AKlPycyozLnLFtSxg" />

  <!-- Primary SEO -->
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
  <meta name="author" content="ReadyStack Digital" />
  <meta name="theme-color" content="#F59E0B" />

  <!-- Canonical -->
  <link rel="canonical" href={canonicalURL} />

  <!-- Feed discovery: fresh-content signal for crawlers and readers -->
  <link rel="alternate" type="application/rss+xml" title="ReadyStack Digital Blog" href="https://readystackdigital.com/rss.xml" />

  <!-- Favicon -->
  <link rel="icon" href="/assets/icons/favicon-32.png" type="image/png" sizes="32x32" />
  <link rel="icon" href="/assets/icons/favicon-16.png" type="image/png" sizes="16x16" />
  <link rel="icon" href="/assets/icons/readystack-icon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/assets/icons/apple-touch-icon.png" sizes="180x180" />
  <link rel="icon" href="/assets/icons/favicon-192.png" type="image/png" sizes="192x192" />
  <link rel="icon" href="/assets/icons/favicon-512.png" type="image/png" sizes="512x512" />
  <meta name="msapplication-TileImage" content="/assets/icons/favicon-192.png" />

  <!-- Open Graph -->
  <meta property="og:type" content={ogType} />
  <meta property="og:locale" content="en_AU" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:site_name" content="ReadyStack Digital" />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="ReadyStack Digital: small business websites, 24/7 AI agents and receptionists, SEO and social content" />

  <!-- Twitter / X -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:image:alt" content="ReadyStack Digital: small business websites, 24/7 AI agents and receptionists, SEO and social content" />

  <!-- Fonts: preconnect + preload critical weight -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Inter:wght@300;400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

  <!-- CSS -->
  <link rel="stylesheet" href="/css/base.css" />
  <link rel="stylesheet" href="/css/layout.css" />
  <link rel="stylesheet" href="/css/components.css" />
  <link rel="stylesheet" href="/css/animations.css" />
  <link rel="stylesheet" href="/css/pages.css" />
  <link rel="stylesheet" href="/css/theme.css" />

  <!-- No-JS fallback: scroll-reveal content must stay visible without animations.js -->
  <noscript>
    <style>
      .reveal, .reveal-left, .reveal-right, .reveal-scale {
        opacity: 1 !important;
        transform: none !important;
      }
      #page-loader { display: none !important; }
    </style>
  </noscript>

  <!-- Schema: LocalBusiness -->
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    "@id": "https://readystackdigital.com/#business",
    "name": "ReadyStack Digital",
    "url": "https://readystackdigital.com/",
    "logo": {
      "@type": "ImageObject",
      "url": "https://readystackdigital.com/assets/icons/readystack-icon.svg"
    },
    "image": "https://readystackdigital.com/assets/images/hero-dashboard.jpg",
    "description": "ReadyStack Digital gets Australian small businesses online and stops them losing work to missed calls. We build fast websites, rebuild slow or outdated ones that no longer generate enquiries, and deploy 24/7 AI receptionists and AI agents that answer calls and messages, qualify enquiries and book jobs into the calendar. Also business email, domain and hosting setup, SEO, monthly website care, and social and blog content. Support across Australia.",
    "knowsAbout": [
      "AI receptionist",
      "AI agents for small business",
      "AI appointment booking agent",
      "After-hours call answering",
      "AI chatbot for websites",
      "Small business website design",
      "Website redesign and rebuilds",
      "SEO",
      "Business email setup",
      "Website care and hosting"
    ],
    "telephone": "+61 2 5944 5135",
    "email": "hello@readystackdigital.com",
    "priceRange": "$$",
    "paymentAccepted": "Bank Transfer, Credit Card",
    "areaServed": {
      "@type": "Country",
      "name": "Australia"
    },
    "contactPoint": {
      "@type": "ContactPoint",
      "telephone": "+61 2 5944 5135",
      "email": "hello@readystackdigital.com",
      "contactType": "customer service",
      "availableLanguage": "English"
    },
    "sameAs": [
      "https://www.facebook.com/profile.php?id=61590500618569",
      "https://www.instagram.com/readystackdigital/",
      "https://www.linkedin.com/in/readystack-digital-06728741a/",
      "https://www.tiktok.com/@readystack.digital"
    ],
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Website and Digital Services",
      "itemListElement": [
        {
          "@type": "Offer",
          "name": "Landing Page Website",
          "description": "One-page website build for local businesses. Fast, mobile-friendly, SEO-ready.",
          "price": "799",
          "priceCurrency": "AUD"
        },
        {
          "@type": "Offer",
          "name": "Website Rebuild",
          "description": "Rebuild of an existing small business website that is slow, outdated, or no longer generating enquiries. Priced by page count, the same as a new build.",
          "price": "799",
          "priceCurrency": "AUD"
        },
        {
          "@type": "Offer",
          "name": "Managed Website Care",
          "description": "Monthly website care including hosting, domain, SSL, forms and basic SEO checks.",
          "price": "149",
          "priceCurrency": "AUD",
          "priceSpecification": {
            "@type": "UnitPriceSpecification",
            "price": "99",
            "priceCurrency": "AUD",
            "unitCode": "MON"
          }
        },
        {
          "@type": "Offer",
          "name": "Website Care Plus",
          "description": "Monthly website care plus extra support and blog upload support.",
          "price": "149",
          "priceCurrency": "AUD",
          "priceSpecification": {
            "@type": "UnitPriceSpecification",
            "price": "149",
            "priceCurrency": "AUD",
            "unitCode": "MON"
          }
        },
        {
          "@type": "Offer",
          "name": "Social Media & Content",
          "description": "Optional monthly social media and blog content for small businesses, with branded posts and captions for Instagram, Facebook, TikTok and LinkedIn to support search and social visibility.",
          "priceCurrency": "AUD"
        },
        {
          "@type": "Offer",
          "name": "AI Agent",
          "description": "An AI agent trained on your business. Three tiers: Chat is included free with any website build at $149/month to run; Reception adds real phone answering, qualifying and calendar booking at $1,499 setup plus $149/month; Custom builds an agent for a specific job, such as chasing quiet quotes or cutting no-shows, and is priced after a consultation.",
          "price": "149",
          "priceCurrency": "AUD"
        }
      ]
    }
  }
  </script>

  <!-- Schema: WebSite. Google reads this for the site name shown above the
       search result ("ReadyStack Digital" instead of readystackdigital.com),
       and it only reads it on the homepage, so keep it homepage-only. -->
  {isHome && (
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "@id": "https://readystackdigital.com/#website",
      url: "https://readystackdigital.com/",
      name: "ReadyStack Digital",
      alternateName: ["ReadyStack", "ReadyStack Digital Australia"],
      description: "Small business websites and 24/7 AI agents and receptionists, plus business email, SEO, website care and social media content, for small businesses across Australia",
      publisher: { "@id": "https://readystackdigital.com/#business" },
      inLanguage: "en-AU",
    })} is:inline />
  )}

  <!-- Schema: BreadcrumbList (per-page) -->
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} is:inline />

  <slot name="head" />
</head>
<body>
  <a href="#main-content" class="skip-link">Skip to content</a>

  <!-- Custom cursor -->
  <div id="cursor" aria-hidden="true">
    <div class="cursor-dot"></div>
    <div class="cursor-ring"></div>
  </div>

  <!-- Page loader -->
  <div id="page-loader" aria-hidden="true">
    <div class="loader-inner">
      <div class="loader-logo">
        <img src="/assets/icons/readystack-icon.svg" alt="" width="36" height="36" />
        <span>ReadyStack Digital</span>
      </div>
      <div class="loader-track"><div class="loader-bar" id="loader-bar"></div></div>
      <div class="loader-label" id="loader-label">Preparing your website setup…</div>
    </div>
  </div>

  <slot />

  <CookieConsent />
  <CartDrawer />
  <MobileTabBar />

  <script src="/js/main.js" is:inline></script>
  <script src="/js/animations.js" is:inline></script>
  <script src="/js/dashboard.js" is:inline></script>
  <script src={import.meta.env.DEV ? "http://localhost:8787/widget.js" : "https://agent.readystackdigital.com/widget.js"} async is:inline></script>
 </body>
</html>
