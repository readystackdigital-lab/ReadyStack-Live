---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import PageHero from "../components/PageHero.astro";
import CtaBand from "../components/CtaBand.astro";
import CostCalculator from "../components/CostCalculator.astro";
import { PRICING } from "../data/pricing";

const categories = [
  {
    tier: "Build",
    slug: "build",
    title: "Website Design & Rebuilds",
    desc: "A fast, professional website that explains what you do and turns visitors into enquiries. Already have one that is slow or dated? We rebuild it.",
    items: ["New business websites", "Rebuilds of slow or outdated sites", "Landing pages", "Built to load fast on phones"],
    icon: `<rect x="3" y="5" width="20" height="14" rx="3" stroke="#F59E0B" stroke-width="1.4" fill="none"/><path d="M3 9h20M8 22h10M13 19v3" stroke="#F59E0B" stroke-width="1.4" stroke-linecap="round"/>`,
    cart: null,
    tierPicker: true,
  },
  {
    tier: "AI Agent",
    slug: "ai",
    title: "AI Receptionist & Custom AI Agents",
    desc: "A chat agent comes free with any website we build. Add Reception and it answers the phone around the clock, from $1,499 setup plus $149/month. Or we build custom agents to automate the repetitive jobs your business never gets to.",
    items: ["Free chat agent with any website build", "Reception answers real phone calls, around the clock", "Books appointments straight into your calendar", "Custom agents built for the repetitive work you want gone", "Chase quotes, reviews and late invoices for you", "Trained on your services, pricing and area"],
    icon: `<rect x="4" y="6" width="18" height="13" rx="4" stroke="#F59E0B" stroke-width="1.4" fill="none"/><path d="M9 19l-2 3 5-3" stroke="#F59E0B" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/><circle cx="10" cy="12.5" r="1.3" fill="#F59E0B"/><circle cx="16" cy="12.5" r="1.3" fill="#F59E0B"/><path d="M13 3v3M11.4 4.2l3.2 1.6M14.6 4.2l-3.2 1.6" stroke="#F59E0B" stroke-width="1.2" stroke-linecap="round"/>`,
    cart: { id: "ai-reception", type: "ai" },
    tierPicker: false,
  },
  {
    tier: "SEO and AI",
    slug: "seo",
    title: "Get Found on Google and in AI",
    desc: "The groundwork that puts you in front of local customers on Google, and gets your business recommended when they ask ChatGPT, Perplexity or Gemini who to call.",
    items: ["Local search setup and Google Business Profile", "Page titles and structure done right", "Structured data so AI assistants can read your business", "Answer-first pages ChatGPT and Perplexity can quote", "Google Search Console"],
    icon: `<path d="M4 19V7a2 2 0 012-2h14a2 2 0 012 2v12" stroke="#F59E0B" stroke-width="1.4" stroke-linecap="round"/><path d="M7 15l3-3 3 2 5-6" stroke="#F59E0B" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="M3 21h20" stroke="#F59E0B" stroke-width="1.4" stroke-linecap="round"/>`,
    cart: { id: "seo", type: "addon" },
    tierPicker: false,
  },
  {
    tier: "Care",
    slug: "care",
    title: "Monthly Website Care",
    desc: "We keep it fast, secure and online so it keeps bringing work in, and you never have to think about it.",
    items: ["Updates and backups", "Uptime and security monitoring", "Speed checks", "Small changes when you need them"],
    icon: `<path d="M13 2L3 7v6C3 18.75 7.5 24 13 25.5 18.5 24 23 18.75 23 13V7L13 2z" stroke="#F59E0B" stroke-width="1.4" fill="rgba(245,158,11,.08)"/><path d="M9.5 13l2.5 2.5 4.5-4.5" stroke="#F59E0B" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>`,
    cart: { id: "care", type: "care" },
    tierPicker: false,
  },
  {
    tier: "Email",
    slug: "email",
    title: "Business Email Setup",
    desc: "Email at your own domain, like info@yourbusiness.com.au, set up so your quotes and replies reach the inbox instead of spam.",
    items: ["Email at your own domain", "Microsoft 365 or Google Workspace", "Set up to land in the inbox", "Ongoing support"],
    icon: `<rect x="3" y="6" width="20" height="14" rx="3" stroke="#F59E0B" stroke-width="1.4" fill="none"/><path d="M4 8l9 7 9-7" stroke="#F59E0B" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"/>`,
    cart: { id: "email", type: "addon" },
    tierPicker: false,
  },
  {
    tier: "Social",
    slug: "social",
    title: "Social Media Content",
    desc: "Branded posts and blogs that keep you visible between jobs, without you having to think about what to post.",
    items: ["Facebook and Instagram", "TikTok", "LinkedIn", "Planned a month at a time"],
    icon: `<rect x="3.5" y="3.5" width="19" height="19" rx="5" stroke="#F59E0B" stroke-width="1.4" fill="none"/><circle cx="13" cy="13" r="4.2" stroke="#F59E0B" stroke-width="1.4" fill="none"/><circle cx="18.2" cy="7.8" r="1.3" fill="#F59E0B"/>`,
    cart: null,
    tierPicker: false,
  },
];

const whyChoose = [
  { t: "One person to call", d: "Website, email, Google, care and your AI receptionist all handled in one place. No chasing three different vendors." },
  { t: "Built for small business", d: "Clear scope and clear prices, sized for a small business rather than an enterprise budget." },
  { t: "Nothing for you to maintain", d: "No plugins to update, no logins to remember. We handle the technical side and keep it out of your way." },
  { t: "No lock-in contracts", d: "Stay because the work brings you customers, not because you are stuck in a contract." },
  { t: "Support across Australia", d: "Plain-English help from people who answer, wherever your business is." },
  { t: "Found on Google and AI from day one", d: "Every site launches with the search and AI groundwork already done, not sold to you later as an extra." },
];
---

<BaseLayout
  title="Website Design, Rebuilds & AI Reception | ReadyStack Digital"
  description="Fast websites and rebuilds for Australian small businesses, plus 24/7 AI receptionists, business email, Google setup and monthly care. Clear pricing, no lock-in."
>
  <Header />
  <main id="main-content">
    <PageHero
      banner="/assets/banners/banner-services-page.webp"
      eyebrow="Our Services"
      title='Everything your business needs to <span class="text-amber">grow online</span>'
      sub="A website that brings in enquiries, an AI receptionist that answers them, and the Google, email and monthly care that keeps it all working. You get on with the job."
      primaryLabel="Get My Free Quote"
      primaryHref="/estimate"
      secondaryLabel="View Packages"
      secondaryHref="/packages"
    />

    <section class="section section-tinted" aria-labelledby="svc-cats-heading">
      <div class="container">
        <div class="section-head reveal">
          <div class="eyebrow">What We Do</div>
          <h2 id="svc-cats-heading" class="section-h2">Everything that brings work in, in one place</h2>
          <p class="section-subline">Take what you need now and add the rest as you grow. Every piece is built to work with the others.</p>
        </div>

        <div class="svc-detail-grid">
          {categories.map((c) => (
            <article class="svc-detail reveal" id={c.slug}>
              <div class="svc-top">
                <div class="svc-icon" aria-hidden="true">
                  <svg width="26" height="26" viewBox="0 0 26 26" fill="none" set:html={c.icon}></svg>
                </div>
                <span class="svc-tier">{c.tier}</span>
              </div>
              <h3 class="svc-name">{c.title}</h3>
              <p class="svc-desc">{c.desc}</p>
              <ul class="feat-list">
                {c.items.map((i) => (
                  <li>
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M2.5 8l3.5 3.5 7.5-7.5" stroke="#10B981" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    {i}
                  </li>
                ))}
              </ul>
              {c.tierPicker ? (
                <div class="svc-detail-cta svc-tiers">
                  <div class="svc-tiers-label">How many pages do you need?</div>
                  <div class="svc-tiers-row">
                    {PRICING.pages.map((p) => (
                      <button type="button" data-cart-add={p.id} data-cart-type="page" class="svc-tier-chip">{p.label}</button>
                    ))}
                  </div>
                </div>
              ) : c.cart ? (
                <div class="svc-detail-cta">
                  <button type="button" data-cart-add={c.cart.id} data-cart-type={c.cart.type} class="btn btn-outline btn-full">Add to cart</button>
                  <a href="/contact" class="svc-talk">or enquire about {c.tier.toLowerCase()}</a>
                </div>
              ) : (
                <a href="/contact" class="btn btn-outline btn-full svc-detail-cta">Enquire about {c.tier.toLowerCase()}</a>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="why-heading">
      <div class="container">
        <div class="section-head reveal">
          <div class="eyebrow">Why ReadyStack</div>
          <h2 id="why-heading" class="section-h2">Why local businesses stay with us</h2>
          <p class="section-subline">Agency-quality work without the agency overhead, priced and scoped for a small business.</p>
        </div>
        <div class="why-grid">
          {whyChoose.map((w, i) => (
            <div class={`offer-card reveal ${i % 3 === 1 ? "reveal-delay-1" : i % 3 === 2 ? "reveal-delay-2" : ""}`}>
              <div class="offer-kicker">0{i + 1}</div>
              <h3 class="svc-name">{w.t}</h3>
              <p class="svc-desc">{w.d}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="section section-tinted" aria-labelledby="svc-estimate-heading">
      <div class="container">
        <div class="section-head reveal">
          <div class="eyebrow">Instant estimate</div>
          <h2 id="svc-estimate-heading" class="section-h2">Get an instant estimate</h2>
          <p class="section-subline">Pick your pages and features to see a transparent price range in seconds. Prefer the full experience? <a href="/estimate" class="text-amber">Open the estimate page</a>.</p>
        </div>
        <div class="reveal">
          <CostCalculator />
        </div>
      </div>
    </section>

    <CtaBand
      heading='Not sure which services you need? <span class="text-amber">Let’s map it out.</span>'
      sub="Tell us about your business and we’ll recommend the right mix of website, email, SEO, care and content, with clear, honest pricing."
      primaryLabel="Get My Free Quote"
      primaryHref="/estimate"
      secondaryLabel="Book a Call"
    />
  </main>
  <Footer />
</BaseLayout>

<style>
  .svc-detail-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-5);
  }
  .svc-detail {
    box-shadow: var(--nm-raised);
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    background: var(--white);
    border: 1px solid var(--charcoal-200);
    border-radius: var(--radius-xl);
    padding: var(--space-6);
    transition: border-color var(--dur-base) var(--ease-out), box-shadow var(--dur-base) var(--ease-out), transform var(--dur-base) var(--ease-out);
  }
  .svc-detail:hover {
    border-color: var(--amber);
    box-shadow: 0 0 0 4px rgba(245, 158, 11, 0.06), var(--shadow-md);
    transform: translateY(-3px);
  }
  .svc-detail .feat-list { margin-top: var(--space-1); }
  .svc-detail-cta { margin-top: auto; }

  .svc-tiers { display: flex; flex-direction: column; gap: var(--space-2); }
  .svc-tiers-label { font-size: var(--text-xs); color: var(--charcoal-500); }
  .svc-tiers-row { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .svc-tier-chip {
    border: 1px solid var(--charcoal-200); border-radius: 999px;
    background: var(--white); color: var(--charcoal-700);
    font-size: var(--text-sm); font-weight: var(--weight-medium);
    padding: .5rem .9rem; cursor: pointer;
    transition: border-color var(--dur-base) var(--ease-out), color var(--dur-base) var(--ease-out), background var(--dur-base) var(--ease-out);
  }
  .svc-tier-chip:hover { border-color: var(--amber); color: var(--amber-600); background: rgba(245, 158, 11, 0.06); }
  .svc-talk { display: block; text-align: center; margin-top: var(--space-2); font-size: var(--text-xs); color: var(--charcoal-500); }
  .svc-talk:hover { color: var(--amber-600); }

  .why-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-5);
  }

  @media (max-width: 980px) {
    .svc-detail-grid,
    .why-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 640px) {
    .svc-detail-grid,
    .why-grid { grid-template-columns: 1fr; }
    .svc-tier-chip,
    .svc-detail .btn { min-height: 44px; }
  }
</style>
