---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Outcomes from '../components/Outcomes.astro';
import Steps from '../components/Steps.astro';
import ServicesOverview from '../components/ServicesOverview.astro';
import Security from '../components/Security.astro';
import Pricing from '../components/Pricing.astro';
import CtaBand from '../components/CtaBand.astro';
import Footer from '../components/Footer.astro';
import SiteMotion from '../components/SiteMotion.astro';
---

<BaseLayout>
  <Header />
  <main id="main-content">
    <Hero />
    <Outcomes />
    <Steps />
    <ServicesOverview />
    <Security />
    <Pricing />
    <CtaBand
      heading='Ready to stop missing <span class="text-amber">work you could have won?</span>'
      sub="Tell us what you do and we’ll show you the simplest way to get online, get found, and answer every enquiry that comes in. Free quote, no obligation."
      primaryLabel="Get My Free Quote"
      primaryHref="/estimate"
      secondaryLabel="Book a Call"
      secondaryHref="/contact#book"
      bookCta={false}
    />
  </main>
  <SiteMotion />
  <Footer />
</BaseLayout>
